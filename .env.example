# Настройки веб-панели CallScope. Скопируйте файл: cp .env.example .env — и впишите значения.
# Файл .env хранится только на этом компьютере (он в .gitignore), в репозиторий не попадает.

# Пароль входа в панель (обязателен; без него `callscope serve` не запустится).
# Один общий пароль руководителя. После смены — перезапустите панель.
CALLSCOPE_PASSWORD=

# Ключ подписи сессий (необязателен). Пусто — сгенерируется сам и сохранится в папке данных
# (файл .secret_key). Смена ключа завершает все открытые сессии.
CALLSCOPE_SECRET_KEY=

# Папка данных панели: база callscope.db, записи audio/, рабочие checklist.yaml и callscope.yaml.
# Пусто — ./callscope-data в папке, откуда запущена панель.
CALLSCOPE_DATA_DIR=

# Адрес и порт панели. Пусто — 127.0.0.1 и 8000 (доступ только с этого компьютера).
# 0.0.0.0 — открыть для локальной сети (пароль всё равно нужен; HTTPS — через обратный прокси).
CALLSCOPE_HOST=
CALLSCOPE_PORT=
