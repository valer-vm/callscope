{
 "mode": "stereo",
 "duration": 45.7728125,
 "segments": [
  {
   "start": 0.0,
   "end": 3.44,
   "text": "Здравствуйте, строй дом, меня зовут Сергей.",
   "channel": "left"
  },
  {
   "start": 3.95,
   "end": 7.11,
   "text": "Добрый день! Хочу заказать окна в квартиру.",
   "channel": "right"
  },
  {
   "start": 7.92,
   "end": 10.06,
   "text": "Какие опна вы ищете и сколько их нужно?",
   "channel": "left"
  },
  {
   "start": 10.86,
   "end": 13.7,
   "text": "Три окна, обычные, в спальню и в детскую.",
   "channel": "right"
  },
  {
   "start": 14.59,
   "end": 17.05,
   "text": "Что для вас главное, тепло или тишина?",
   "channel": "left"
  },
  {
   "start": 17.89,
   "end": 19.89,
   "text": "Тишина, у нас рядом дорога.",
   "channel": "right"
  },
  {
   "start": 20.59,
   "end": 25.17,
   "text": "Тогда я рекомендую двухкамерный пластиковый профиль, он хорошо глушит шум.",
   "channel": "left"
  },
  {
   "start": 26.01,
   "end": 28.39,
   "text": "Понятно, а сколько это будет стоить?",
   "channel": "right"
  },
  {
   "start": 29.09,
   "end": 31.83,
   "text": "Три окна выйдут примерно в 45 тысяч рублей.",
   "channel": "left"
  },
  {
   "start": 32.74,
   "end": 35.42,
   "text": "Ой, дороговато, я пока подумаю.",
   "channel": "right"
  },
  {
   "start": 36.24,
   "end": 39.14,
   "text": "Но, это наша цена, дешевле не получится.",
   "channel": "left"
  },
  {
   "start": 40.13,
   "end": 42.37,
   "text": "Понятно, тогда я позже позвоню.",
   "channel": "right"
  },
  {
   "start": 43.2,
   "end": 43.62,
   "text": "Хорошо,",
   "channel": "left"
  },
  {
   "start": 44.12,
   "end": 44.76,
   "text": "до свидания.",
   "channel": "left"
  }
 ]
}
