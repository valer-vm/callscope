{
 "mode": "stereo",
 "duration": 55.118125,
 "segments": [
  {
   "start": 0.0,
   "end": 4.82,
   "text": "Здравствуйте, меня зовут Ольга, компания «Строй дом», слушаю вас.",
   "channel": "left"
  },
  {
   "start": 5.42,
   "end": 9.3,
   "text": "Добрый день, нужна консультация по тёплому полу в спальню.",
   "channel": "right"
  },
  {
   "start": 10.15,
   "end": 10.51,
   "text": "Конечно,",
   "channel": "left"
  },
  {
   "start": 11.07,
   "end": 14.11,
   "text": "какая у вас спальня по размеру и какое там покрытие.",
   "channel": "left"
  },
  {
   "start": 14.83,
   "end": 17.21,
   "text": "Двенадцать метров, будет ламинат.",
   "channel": "right"
  },
  {
   "start": 17.89,
   "end": 22.11,
   "text": "А для чего вам теплый пол, это основной отоплению или для комфорта?",
   "channel": "left"
  },
  {
   "start": 23.0,
   "end": 25.68,
   "text": "Для комфорта, чтобы утром ноги не мёрзли.",
   "channel": "right"
  },
  {
   "start": 26.47,
   "end": 31.15,
   "text": "Тогда я предлагаю электрический нагревательный мат подламинот, он вам подойдет.",
   "channel": "left"
  },
  {
   "start": 32.04,
   "end": 33.48,
   "text": "А кто его устанавливает?",
   "channel": "right"
  },
  {
   "start": 34.23,
   "end": 38.99,
   "text": "Наш мастер, давайте я запишу вас на замер, он приедет и все посмотрит.",
   "channel": "left"
  },
  {
   "start": 39.79,
   "end": 40.23,
   "text": "Давайте,",
   "channel": "right"
  },
  {
   "start": 40.75,
   "end": 41.39,
   "text": "а когда можно?",
   "channel": "right"
  },
  {
   "start": 42.28,
   "end": 45.88,
   "text": "Могу в среду в 10 утра, вам удобно? Тогда",
   "channel": "left"
  },
  {
   "start": 45.71,
   "end": 47.29,
   "text": "Да, в среду подойдёт.",
   "channel": "right"
  },
  {
   "start": 48.32,
   "end": 51.58,
   "text": "записала, спасибо за звонок, хорошего дня!",
   "channel": "left"
  },
  {
   "start": 52.41,
   "end": 52.95,
   "text": "Спасибо,",
   "channel": "right"
  },
  {
   "start": 53.47,
   "end": 54.11,
   "text": "до свидания.",
   "channel": "right"
  }
 ]
}
