{
 "mode": "stereo",
 "duration": 36.689,
 "segments": [
  {
   "start": 0.0,
   "end": 3.72,
   "text": "Добрый день, компания «Стройдом», меня зовут Ольга.",
   "channel": "left"
  },
  {
   "start": 4.34,
   "end": 5.18,
   "text": "Здравствуйте!",
   "channel": "right"
  },
  {
   "start": 5.7,
   "end": 7.28,
   "text": "Мне нужна плитка в ванную.",
   "channel": "right"
  },
  {
   "start": 8.08,
   "end": 9.48,
   "text": "Вы уже выбирали плитку?",
   "channel": "left"
  },
  {
   "start": 10.16,
   "end": 12.02,
   "text": "Нет, пока только смотрю.",
   "channel": "right"
  },
  {
   "start": 12.74,
   "end": 14.96,
   "text": "Понятно, вам нужна глянцевая?",
   "channel": "left"
  },
  {
   "start": 15.8,
   "end": 17.7,
   "text": "Наверное, я еще не знаю.",
   "channel": "right"
  },
  {
   "start": 18.55,
   "end": 22.69,
   "text": "Тогда я предлагаю нашу плитку из каталога, она многим подходит.",
   "channel": "left"
  },
  {
   "start": 23.6,
   "end": 23.98,
   "text": "Хорошо,",
   "channel": "right"
  },
  {
   "start": 24.5,
   "end": 25.48,
   "text": "а где можно посмотреть?",
   "channel": "right"
  },
  {
   "start": 26.61,
   "end": 30.87,
   "text": "Все есть в каталоге на сайте, если понадобится, звоните нам.",
   "channel": "left"
  },
  {
   "start": 31.68,
   "end": 32.74,
   "text": "Ладно, понятно.",
   "channel": "right"
  },
  {
   "start": 33.87,
   "end": 35.65,
   "text": "Всего доброго, до свидания!",
   "channel": "left"
  }
 ]
}
