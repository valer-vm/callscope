{
 "mode": "stereo",
 "duration": 40.993375,
 "segments": [
  {
   "start": 0.0,
   "end": 3.74,
   "text": "Добрый день! Компания «Строй дом», меня зовут Игорь.",
   "channel": "left"
  },
  {
   "start": 4.27,
   "end": 5.07,
   "text": "Здравствуйте!",
   "channel": "right"
  },
  {
   "start": 5.61,
   "end": 7.61,
   "text": "Хочу узнать про натяжные потолки.",
   "channel": "right"
  },
  {
   "start": 8.45,
   "end": 8.81,
   "text": "Конечно,",
   "channel": "left"
  },
  {
   "start": 9.37,
   "end": 12.47,
   "text": "в какой комнате вы хотите потолок и какая там высота?",
   "channel": "left"
  },
  {
   "start": 13.29,
   "end": 15.37,
   "text": "В гостиной высота обычная.",
   "channel": "right"
  },
  {
   "start": 16.29,
   "end": 17.61,
   "text": "А какой цвет вам нравится,",
   "channel": "left"
  },
  {
   "start": 18.11,
   "end": 19.33,
   "text": "и нужны ли светильники?",
   "channel": "left"
  },
  {
   "start": 20.19,
   "end": 22.53,
   "text": "Белый матовый и светильники нужны.",
   "channel": "right"
  },
  {
   "start": 23.22,
   "end": 29.06,
   "text": "Тогда я рекомендую матовое полотно со встроенными светильниками, оно смотрится очень аккуратно.",
   "channel": "left"
  },
  {
   "start": 29.86,
   "end": 30.7,
   "text": "Звучит хорошо.",
   "channel": "right"
  },
  {
   "start": 31.24,
   "end": 31.64,
   "text": "Спасибо,",
   "channel": "right"
  },
  {
   "start": 32.16,
   "end": 32.66,
   "text": "всё понятно.",
   "channel": "right"
  },
  {
   "start": 33.71,
   "end": 36.11,
   "text": "Рад помочь, если появятся вопросы,",
   "channel": "left"
  },
  {
   "start": 36.63,
   "end": 38.29,
   "text": "звоните нам. До свидания!",
   "channel": "left"
  },
  {
   "start": 39.26,
   "end": 39.98,
   "text": "До свидания!",
   "channel": "right"
  }
 ]
}
