    {
      "index": 0,
      "start": 0.0,
      "end": 4.8,
      "text": "Добрый день! Компания СтройДом, меня зовут Мария.",
      "role": "manager"
    },
    {
      "index": 1,
      "start": 5.4,
      "end": 9.8,
      "text": "Здравствуйте, интересует утепление балкона.",
      "role": "client"
    },
    {
      "index": 2,
      "start": 10.4,
      "end": 15.4,
      "text": "Какая площадь балкона и что хотите получить в итоге?",
      "role": "manager"
    },
    {
      "index": 3,
      "start": 16.0,
      "end": 20.1,
      "text": "Шесть метров, хочу сделать там кабинет.",
      "role": "client"
    },
    {
      "index": 4,
      "start": 20.7,
      "end": 24.1,
      "text": "Как сейчас застеклён балкон?",
      "role": "manager"
    },
    {
      "index": 5,
      "start": 24.7,
      "end": 27.7,
      "text": "Старые деревянные рамы.",
      "role": "client"
    },
    {
      "index": 6,
      "start": 28.3,
      "end": 36.3,
      "text": "Предлагаю пакет «Тёплый балкон» под ключ: остекление, утепление и отделка, сто восемьдесят тысяч.",
      "role": "manager"
    },
    {
      "index": 7,
      "start": 36.9,
      "end": 41.9,
      "text": "Ой, у конкурентов дешевле, мне называли сто двадцать.",
      "role": "client"
    },
    {
      "index": 8,
      "start": 42.5,
      "end": 45.4,
      "text": "Ну, у нас такие цены.",
      "role": "manager"
    },
    {
      "index": 9,
      "start": 46.0,
      "end": 48.6,
      "text": "Тогда я подумаю.",
      "role": "client"
    },
    {
      "index": 10,
      "start": 49.2,
      "end": 52.4,
      "text": "Хорошо, звоните, если что.",
      "role": "manager"
    },
    {
      "index": 11,
      "start": 53.0,
      "end": 54.9,
      "text": "Ладно.",
      "role": "client"
    },
    {
      "index": 12,
      "start": 55.5,
      "end": 57.8,
      "text": "До свидания.",
      "role": "manager"
    }
