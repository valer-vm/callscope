{
  "approximate": false,
  "manager_channel": "left",
  "role_source": "intro",
  "utterances": [
    {
      "index": 0,
      "start": 0.0,
      "end": 5.9,
      "text": "Здравствуйте! Меня зовут Анна, компания СтройДом. Чем могу помочь?",
      "role": "manager"
    },
    {
      "index": 1,
      "start": 6.5,
      "end": 11.8,
      "text": "Добрый день. Хочу сделать ремонт на кухне, нужен ламинат.",
      "role": "client"
    },
    {
      "index": 2,
      "start": 12.4,
      "end": 17.4,
      "text": "Отлично. Какая площадь кухни и что за основание пола?",
      "role": "manager"
    },
    {
      "index": 3,
      "start": 18.0,
      "end": 22.2,
      "text": "Около двенадцати метров, бетонная стяжка.",
      "role": "client"
    },
    {
      "index": 4,
      "start": 22.8,
      "end": 28.8,
      "text": "А как вы планируете пользоваться кухней, есть ли дети или животные?",
      "role": "manager"
    },
    {
      "index": 5,
      "start": 29.4,
      "end": 32.5,
      "text": "Да, двое детей и собака.",
      "role": "client"
    },
    {
      "index": 6,
      "start": 33.1,
      "end": 43.1,
      "text": "Тогда вам подойдет влагостойкий ламинат тридцать третьего класса, я рекомендую коллекцию Аква, она выдерживает воду и царапины.",
      "role": "manager"
    },
    {
      "index": 7,
      "start": 43.7,
      "end": 48.7,
      "text": "Звучит хорошо, но это дорого, двадцать тысяч за всё.",
      "role": "client"
    },
    {
      "index": 8,
      "start": 49.3,
      "end": 58.3,
      "text": "Понимаю. Зато он прослужит больше пятнадцати лет, на него гарантия, а ещё можно оформить рассрочку без переплаты.",
      "role": "manager"
    },
    {
      "index": 9,
      "start": 58.9,
      "end": 61.9,
      "text": "Рассрочка мне подходит.",
      "role": "client"
    },
    {
      "index": 10,
      "start": 62.5,
      "end": 69.1,
      "text": "Давайте я запишу вас на бесплатный замер. Когда вам удобно, завтра в десять?",
      "role": "manager"
    },
    {
      "index": 11,
      "start": 69.7,
      "end": 73.0,
      "text": "Да, завтра в десять удобно.",
      "role": "client"
    },
    {
      "index": 12,
      "start": 73.6,
      "end": 80.5,
      "text": "Договорились, замерщик приедет завтра в десять. Спасибо за звонок, всего доброго!",
      "role": "manager"
    },
    {
      "index": 13,
      "start": 81.1,
      "end": 84.0,
      "text": "Спасибо, до свидания.",
      "role": "client"
    }
  ]
}
